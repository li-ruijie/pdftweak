#include <winres.h>
#include "core/version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_UK

1 ICON "..\\..\\res\\pdftweak.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PDFTWEAK_VERSION_MAJOR, PDFTWEAK_VERSION_MINOR, PDFTWEAK_VERSION_PATCH, 0
 PRODUCTVERSION PDFTWEAK_VERSION_MAJOR, PDFTWEAK_VERSION_MINOR, PDFTWEAK_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "FileDescription", PDFTWEAK_PROGRAM_NAME
            VALUE "FileVersion", PDFTWEAK_VERSION_STRING
            VALUE "InternalName", "pdftweak"
            VALUE "LegalCopyright", "GNU Affero General Public License, version 3 or later"
            VALUE "OriginalFilename", "pdftweak.exe"
            VALUE "ProductName", PDFTWEAK_PROGRAM_NAME
            VALUE "ProductVersion", PDFTWEAK_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
